<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/toolbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/page_background">

        <com.ithamedia.pdfsigner.PdfPageView
            android:id="@+id/pageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/signHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_margin="12dp"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/sign_hint"
            android:textAppearance="@style/TextAppearance.Atelier.Meta"
            android:textColor="@color/on_ink" />

        <include layout="@layout/busy_overlay" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/pageNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <Button
            android:id="@+id/prevPage"
            style="@style/Widget.Atelier.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/previous_page"
            app:icon="@drawable/ic_chevron_left" />

        <TextView
            android:id="@+id/pageIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Atelier.Meta" />

        <Button
            android:id="@+id/nextPage"
            style="@style/Widget.Atelier.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/next_page"
            app:icon="@drawable/ic_chevron_right" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

                <Button
                    android:id="@+id/toolSignature"
                    style="@style/Widget.Atelier.ToolKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_signature"
                    app:icon="@drawable/ic_signature" />
                <Button
                    android:id="@+id/toolInitials"
                    style="@style/Widget.Atelier.ToolKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/initials"
                    app:icon="@drawable/ic_initials" />
                <Button
                    android:id="@+id/toolText"
                    style="@style/Widget.Atelier.ToolKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_text"
                    app:icon="@drawable/ic_text" />
                <Button
                    android:id="@+id/toolDate"
                    style="@style/Widget.Atelier.ToolKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/date"
                    app:icon="@drawable/ic_calendar" />
                <Button
                    android:id="@+id/toolCheck"
                    style="@style/Widget.Atelier.ToolKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/check_mark"
                    app:icon="@drawable/ic_check" />
                <Button
                    android:id="@+id/toolCross"
                    style="@style/Widget.Atelier.ToolKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cross_mark"
                    app:icon="@drawable/ic_close" />
                <Button
                    android:id="@+id/toolDot"
                    style="@style/Widget.Atelier.ToolKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dot_mark"
                    app:icon="@drawable/ic_dot" />
                <Button
                    android:id="@+id/toolLine"
                    style="@style/Widget.Atelier.ToolKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/line_mark"
                    app:icon="@drawable/ic_minus" />
                <Button
                    android:id="@+id/toolStamp"
                    style="@style/Widget.Atelier.ToolKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stamp"
                    app:icon="@drawable/ic_stamp" />
                <Button
                    android:id="@+id/toolImage"
                    style="@style/Widget.Atelier.ToolKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/image"
                    app:icon="@drawable/ic_image" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/inkToggle"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="16dp">

            <View
                android:id="@+id/inkSwatch"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/ink"
                android:textAppearance="@style/TextAppearance.Atelier.Label" />
        </LinearLayout>

        <Button
            android:id="@+id/saveButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/save_pdf"
            app:icon="@drawable/ic_check" />
    </LinearLayout>
</LinearLayout>
