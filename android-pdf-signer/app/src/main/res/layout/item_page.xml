<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="156dp"
            android:background="@color/surface_sunk"
            android:padding="8dp">

            <ImageView
                android:id="@+id/pageThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/pageNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:background="@drawable/bg_badge"
                android:minWidth="22dp"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:textAppearance="@style/TextAppearance.Atelier.Meta"
                android:textColor="@color/on_ink" />

            <ImageView
                android:id="@+id/pageCheck"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_selected_badge"
                android:importantForAccessibility="no"
                android:padding="4dp"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@color/on_accent" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/pageActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/pageRotate"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/rotate"
                android:src="@drawable/ic_rotate"
                app:tint="@color/ink_soft" />

            <ImageButton
                android:id="@+id/pageDelete"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/action_delete"
                android:src="@drawable/ic_delete"
                app:tint="@color/ink_soft" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
